{
  "rewrites": [
    {
      "source": "/t/:slug",
      "destination": "/index.html"
    },
    {
      "source": "/inscricao/:id",
      "destination": "/index.html"
    },
    {
      "source": "/painel",
      "destination": "/index.html"
    },
    {
      "source": "/login",
      "destination": "/index.html"
    },
    {
      "source": "/favoritos",
      "destination": "/index.html"
    },
    {
      "source": "/minhas-inscricoes",
      "destination": "/index.html"
    },
    {
      "source": "/atleta",
      "destination": "/index.html"
    },
    {
      "source": "/ranking",
      "destination": "/index.html"
    },
    {
      "source": "/atletas/:code",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/login",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/painel",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/inscricao/:id",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/favoritos",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/minhas-inscricoes",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/atleta",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}
